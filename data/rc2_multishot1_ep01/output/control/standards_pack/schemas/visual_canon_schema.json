{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Visual Quality Canon Schema",
  "type": "object",
  "required": ["canon_id", "version", "scope", "quality_dimensions"],
  "properties": {
    "canon_id": { "type": "string" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "task_id": { "type": "string" },
    "description": { "type": "string" },
    "scope": {
      "type": "string",
      "enum": ["visual", "motion", "face", "anatomy", "identity", "timeline", "preview", "audio", "voice", "assembly", "state_audit"]
    },
    "quality_dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dimension_id", "name", "description"],
        "properties": {
          "dimension_id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "acceptance_criteria": { "type": "string" },
          "rejection_criteria": { "type": "string" },
          "severity_if_failed": {
            "type": "string",
            "enum": ["info", "warning", "major", "critical", "blocker"]
          }
        }
      }
    },
    "references": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
