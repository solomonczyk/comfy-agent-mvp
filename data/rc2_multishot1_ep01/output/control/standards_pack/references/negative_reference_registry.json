{
  "registry_id": "negative_reference_registry",
  "version": "1.0.0",
  "task_id": "RC-COMBINE-V2-MACHINE-READABLE-STANDARDS-PACK-001",
  "description": "Registry of negative references to block repeated failure patterns.",
  "references": [],
  "rules": {
    "acceptance_criteria_for_negative_reference": [
      "defect_must_be_documented_in_defect_taxonomy",
      "source_artifact_path_must_be_recorded",
      "reason_must_document_failure_pattern"
    ],
    "usage_rules": [
      "negative_references_may_be_used_to_block_repeated_failure_patterns",
      "negative_references_must_not_be_used_as_positive_examples",
      "negative_references_must_not_be_used_for_training_without_operator_approval"
    ],
    "forbidden_usage": [
      "learning_from_bad_outputs_as_positive_examples",
      "using_negative_references_as_style_targets",
      "distributing_negative_references_without_context"
    ]
  }
}
