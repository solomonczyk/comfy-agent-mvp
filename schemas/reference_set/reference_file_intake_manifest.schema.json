{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.combine.ai/reference_set/intake_manifest.schema.json",
  "title": "Reference File Intake Manifest",
  "description": "Manifest listing all reference files discovered in the dropzone with their validation status",
  "type": "object",
  "required": [
    "manifest_version",
    "blueprint_stage_id",
    "dropzone_root_path",
    "scan_timestamp",
    "reference_files",
    "slot_mapping_summary"
  ],
  "properties": {
    "manifest_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "blueprint_stage_id": {
      "type": "string"
    },
    "dropzone_root_path": {
      "type": "string"
    },
    "scan_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "reference_files": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/reference_file_entry"
      }
    },
    "slot_mapping_summary": {
      "$ref": "#/definitions/slot_mapping_summary"
    }
  },
  "definitions": {
    "reference_file_entry": {
      "type": "object",
      "required": [
        "file_path",
        "file_name",
        "file_size_bytes",
        "sha256_checksum",
        "validation_status",
        "assigned_slot_id"
      ],
      "properties": {
        "file_path": {
          "type": "string",
          "description": "Absolute or relative path to the reference file"
        },
        "file_name": {
          "type": "string"
        },
        "file_size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256_checksum": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA256 checksum of the file"
        },
        "validation_status": {
          "$ref": "#/definitions/validation_status"
        },
        "assigned_slot_id": {
          "type": "string",
          "description": "ID of the reference slot this file is assigned to"
        },
        "image_dimensions": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "file_format": {
          "type": "string",
          "enum": ["jpg", "jpeg", "png", "webp"]
        },
        "readable": {
          "type": "boolean"
        },
        "validation_errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "validation_status": {
      "type": "string",
      "enum": [
        "valid",
        "missing",
        "unreadable",
        "invalid_format",
        "size_exceeded",
        "dimensions_insufficient",
        "checksum_failed"
      ]
    },
    "slot_mapping_summary": {
      "type": "object",
      "required": ["total_slots", "filled_slots", "missing_required_slots", "readiness_status"],
      "properties": {
        "total_slots": {
          "type": "integer",
          "minimum": 0
        },
        "filled_slots": {
          "type": "integer",
          "minimum": 0
        },
        "missing_required_slots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "IDs of required slots that are not filled"
        },
        "readiness_status": {
          "type": "string",
          "enum": [
            "ready",
            "pending_operator_supply",
            "blocked_missing_required_reference",
            "blocked_invalid_reference"
          ]
        }
      }
    }
  }
}
