{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workflow Registry Schema",
  "description": "Registry containing all workflow contracts, blueprints, and reference packs. Project-agnostic.",
  "type": "object",
  "required": ["registry_id", "version"],
  "properties": {
    "registry_id": {
      "type": "string",
      "description": "Unique identifier for the registry"
    },
    "version": {
      "type": "string",
      "description": "Version of the registry"
    },
    "workflow_contracts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "workflow_contract.schema.json"
      },
      "default": {},
      "description": "Workflow contracts by ID"
    },
    "pipeline_blueprints": {
      "type": "object",
      "additionalProperties": {
        "$ref": "pipeline_blueprint.schema.json"
      },
      "default": {},
      "description": "Pipeline blueprints by ID"
    },
    "reference_packs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "reference_pack.schema.json"
      },
      "default": {},
      "description": "Reference packs by ID"
    },
    "gate_contracts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "gate_contract.schema.json"
      },
      "default": {},
      "description": "Gate contracts by ID"
    },
    "execution_contracts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "execution_contract.schema.json"
      },
      "default": {},
      "description": "Execution contracts by ID"
    },
    "metadata": {
      "type": "object",
      "default": {},
      "description": "Additional metadata"
    }
  }
}
