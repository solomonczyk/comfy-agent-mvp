{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workflow Contract Schema",
  "description": "Contract defining a workflow's inputs, outputs, and constraints. Project-agnostic.",
  "type": "object",
  "required": ["workflow_id", "workflow_type"],
  "properties": {
    "workflow_id": {
      "type": "string",
      "description": "Unique identifier for the workflow"
    },
    "workflow_type": {
      "type": "string",
      "enum": ["image", "video", "audio", "editorial", "qa", "assembly", "custom"],
      "description": "Type of workflow"
    },
    "project_agnostic": {
      "type": "boolean",
      "default": true,
      "description": "Whether the workflow is project-agnostic"
    },
    "required_inputs": {
      "type": "array",
      "items": {"type": "string"},
      "default": [],
      "description": "Required input identifiers"
    },
    "optional_inputs": {
      "type": "array",
      "items": {"type": "string"},
      "default": [],
      "description": "Optional input identifiers"
    },
    "outputs": {
      "type": "array",
      "items": {"type": "string"},
      "default": [],
      "description": "Output identifiers"
    },
    "forbidden_actions": {
      "type": "array",
      "items": {"type": "string"},
      "default": [],
      "description": "Actions that are forbidden in this workflow"
    },
    "required_gates": {
      "type": "array",
      "items": {"type": "string"},
      "default": [],
      "description": "Gates that must be passed"
    },
    "execution_allowed_by_default": {
      "type": "boolean",
      "default": false,
      "description": "Whether execution is allowed without explicit authorization"
    }
  }
}
