{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://combine.ai/schemas/evidence_trace/audit_carryover_report.schema.json",
  "title": "Audit Carryover Report",
  "description": "Report on audit carryover from previous violations. Project-agnostic.",
  "type": "object",
  "required": [
    "report_id",
    "task_id",
    "carryover_items"
  ],
  "properties": {
    "report_id": {
      "type": "string",
      "description": "Report identifier"
    },
    "task_id": {
      "type": "string",
      "description": "Task identifier this report belongs to"
    },
    "carryover_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "violation_type",
          "original_event_id",
          "carryover_status"
        ],
        "properties": {
          "violation_type": {
            "type": "string"
          },
          "original_event_id": {
            "type": "string"
          },
          "carryover_status": {
            "type": "string",
            "enum": [
              "recorded",
              "ignored",
              "resolved"
            ]
          },
          "details": {
            "type": "string"
          }
        }
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    }
  }
}
