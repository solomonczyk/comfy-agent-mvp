{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://combine.ai/schemas/reference_pack/reference_asset.schema.json",
  "title": "Reference Asset",
  "description": "Individual reference asset within a slot",
  "type": "object",
  "required": ["asset_id"],
  "properties": {
    "asset_id": {
      "type": "string",
      "pattern": "^[a-z0-9_\\-]+$"
    },
    "file_path": {
      "type": ["string", "null"],
      "description": "Null for future/unpopulated assets"
    },
    "canonical_name": {
      "type": ["string", "null"]
    },
    "file_exists": {
      "type": "boolean"
    },
    "sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "width": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "height": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "size_bytes": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "format": {
      "type": ["string", "null"],
      "enum": ["png", "jpg", "jpeg", null]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "variant_label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "license": {
          "type": "string"
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["present", "pending_operator_supply"]
    }
  }
}
