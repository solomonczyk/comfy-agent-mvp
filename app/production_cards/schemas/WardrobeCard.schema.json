{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WardrobeCard",
  "description": "Defines character clothing, accessories, and appearance details.",
  "type": "object",
  "required": [
    "card_id",
    "card_type",
    "project_id",
    "owner_role",
    "status",
    "version",
    "required_inputs",
    "references",
    "constraints",
    "allowed_variations",
    "forbidden_drift",
    "dependencies",
    "approval_required_by",
    "next_action_if_missing",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "card_id": {
      "type": "string",
      "description": "Unique identifier for this card"
    },
    "card_type": {
      "type": "string",
      "const": "WardrobeCard",
      "description": "Card type identifier"
    },
    "project_id": {
      "type": "string",
      "description": "Project identifier"
    },
    "owner_role": {
      "type": "string",
      "enum": ["Wardrobe/Character Director"],
      "description": "Role that owns this card"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "needs_references", "needs_role_work", "ready_for_review", "approved", "blocked", "deprecated"],
      "description": "Current status of the card"
    },
    "version": {
      "type": "string",
      "description": "Card version"
    },
    "required_inputs": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "visual_reference_paths": {"type": "array", "items": {"type": "string"}},
        "description": {"type": "string"}
      },
      "required": ["name", "visual_reference_paths", "description"]
    },
    "references": {
      "type": "array",
      "items": {"type": "string"},
      "description": "References to CharacterCard"
    },
    "constraints": {
      "type": "object",
      "properties": {
        "min_references": {"type": "integer"}
      }
    },
    "allowed_variations": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Allowed variations within this card type"
    },
    "forbidden_drift": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Changes that are not allowed once approved"
    },
    "dependencies": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Dependencies on CharacterCard"
    },
    "approval_required_by": {
      "type": "string",
      "enum": ["Wardrobe/Character Director"],
      "description": "Role required to approve this card"
    },
    "next_action_if_missing": {
      "type": "string",
      "description": "Action to take if this card is missing"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when card was created"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when card was last updated"
    },
    "character_reference": {
      "type": "string",
      "description": "CharacterCard ID"
    },
    "name": {
      "type": "string",
      "description": "Outfit name"
    },
    "wardrobe_director": {
      "type": "string",
      "description": "Wardrobe director name or ID"
    },
    "visual_reference_paths": {
      "type": "array",
      "items": {"type": "string"},
      "description": "List of reference images"
    },
    "description": {
      "type": "string",
      "description": "Clothing description"
    },
    "accessories": {
      "type": "array",
      "items": {"type": "string"},
      "description": "List of items"
    },
    "color_scheme": {
      "type": "object",
      "description": "Primary colors"
    },
    "material_types": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Fabric/texture notes"
    }
  }
}
