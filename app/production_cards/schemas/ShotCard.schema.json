{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ShotCard",
  "description": "Atomic unit of generation. Single continuous camera take with specific action, camera, and composition.",
  "type": "object",
  "required": [
    "card_id",
    "card_type",
    "project_id",
    "owner_role",
    "status",
    "version",
    "required_inputs",
    "references",
    "constraints",
    "allowed_variations",
    "forbidden_drift",
    "dependencies",
    "approval_required_by",
    "next_action_if_missing",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "card_id": {
      "type": "string",
      "description": "Unique identifier for this card"
    },
    "card_type": {
      "type": "string",
      "const": "ShotCard",
      "description": "Card type identifier"
    },
    "project_id": {
      "type": "string",
      "description": "Project identifier"
    },
    "owner_role": {
      "type": "string",
      "enum": ["Shot Designer / Storyboard Agent"],
      "description": "Role that owns this card"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "needs_references", "needs_role_work", "ready_for_review", "approved", "blocked", "deprecated"],
      "description": "Current status of the card"
    },
    "version": {
      "type": "string",
      "description": "Card version"
    },
    "required_inputs": {
      "type": "object",
      "properties": {
        "shot_number": {"type": "integer"},
        "shot_type": {"type": "string"},
        "action_description": {"type": "string"},
        "duration_seconds": {"type": "number"}
      },
      "required": ["shot_number", "shot_type", "action_description", "duration_seconds"]
    },
    "references": {
      "type": "array",
      "items": {"type": "string"},
      "description": "References to ScenarioCard, CharacterCard, EnvironmentCard, CameraCard, LightingCard, StyleCard"
    },
    "constraints": {
      "type": "object",
      "properties": {
        "min_duration": {"type": "number"},
        "max_duration": {"type": "number"}
      }
    },
    "allowed_variations": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Allowed variations within this card type"
    },
    "forbidden_drift": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Changes that are not allowed once approved"
    },
    "dependencies": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Dependencies on ScenarioCard and all asset cards"
    },
    "approval_required_by": {
      "type": "string",
      "enum": ["Shot Designer / Storyboard Agent"],
      "description": "Role required to approve this card"
    },
    "next_action_if_missing": {
      "type": "string",
      "description": "Action to take if this card is missing"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when card was created"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when card was last updated"
    },
    "shot_number": {
      "type": "integer",
      "description": "Sequence number"
    },
    "shot_type": {
      "type": "string",
      "description": "Close-up, medium, wide, etc."
    },
    "action_description": {
      "type": "string",
      "description": "What happens in shot"
    },
    "duration_seconds": {
      "type": "number",
      "description": "Expected length"
    },
    "character_reference": {
      "type": "string",
      "description": "CharacterCard ID (if character present)"
    },
    "environment_reference": {
      "type": "string",
      "description": "EnvironmentCard ID"
    },
    "camera_reference": {
      "type": "string",
      "description": "CameraCard ID"
    },
    "lighting_reference": {
      "type": "string",
      "description": "LightingCard ID"
    },
    "style_reference": {
      "type": "string",
      "description": "StyleCard ID"
    },
    "wardrobe_reference": {
      "type": "string",
      "description": "WardrobeCard ID (optional)"
    },
    "prop_references": {
      "type": "array",
      "items": {"type": "string"},
      "description": "List of PropCard IDs (optional)"
    }
  }
}
