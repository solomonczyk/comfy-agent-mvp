{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkflowRecipeCard",
  "description": "Defines ComfyUI workflow graph, node parameters, and generation pipeline configuration.",
  "type": "object",
  "required": [
    "card_id",
    "card_type",
    "project_id",
    "owner_role",
    "status",
    "version",
    "required_inputs",
    "references",
    "constraints",
    "allowed_variations",
    "forbidden_drift",
    "dependencies",
    "approval_required_by",
    "next_action_if_missing",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "card_id": {
      "type": "string",
      "description": "Unique identifier for this card"
    },
    "card_type": {
      "type": "string",
      "const": "WorkflowRecipeCard",
      "description": "Card type identifier"
    },
    "project_id": {
      "type": "string",
      "description": "Project identifier"
    },
    "owner_role": {
      "type": "string",
      "enum": ["Workflow TD / ComfyUI Technical Director"],
      "description": "Role that owns this card"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "needs_references", "needs_role_work", "ready_for_review", "approved", "blocked", "deprecated"],
      "description": "Current status of the card"
    },
    "version": {
      "type": "string",
      "description": "Card version"
    },
    "required_inputs": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "workflow_graph": {"type": "object"},
        "input_mappings": {"type": "object"},
        "output_mappings": {"type": "object"}
      },
      "required": ["name", "workflow_graph", "input_mappings", "output_mappings"]
    },
    "references": {
      "type": "array",
      "items": {"type": "string"},
      "description": "No references (technical specification)"
    },
    "constraints": {
      "type": "object",
      "properties": {
        "max_generation_time": {"type": "number"},
        "min_gpu_memory": {"type": "number"}
      }
    },
    "allowed_variations": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Allowed variations within this card type"
    },
    "forbidden_drift": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Changes that are not allowed once approved"
    },
    "dependencies": {
      "type": "array",
      "items": {"type": "string"},
      "description": "No dependencies (technical specification)"
    },
    "approval_required_by": {
      "type": "string",
      "enum": ["Workflow TD / ComfyUI Technical Director"],
      "description": "Role required to approve this card"
    },
    "next_action_if_missing": {
      "type": "string",
      "description": "Action to take if this card is missing"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when card was created"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when card was last updated"
    },
    "name": {
      "type": "string",
      "description": "Workflow name"
    },
    "workflow_td": {
      "type": "string",
      "description": "Workflow TD name or ID"
    },
    "workflow_graph": {
      "type": "object",
      "description": "ComfyUI API format JSON"
    },
    "node_parameters": {
      "type": "object",
      "description": "Parameter overrides"
    },
    "input_mappings": {
      "type": "object",
      "description": "Card fields to workflow inputs"
    },
    "output_mappings": {
      "type": "object",
      "description": "Workflow outputs to artifacts"
    },
    "resource_requirements": {
      "type": "object",
      "description": "GPU, memory, etc."
    },
    "estimated_generation_time": {
      "type": "number",
      "description": "Per-frame duration in seconds"
    }
  }
}
