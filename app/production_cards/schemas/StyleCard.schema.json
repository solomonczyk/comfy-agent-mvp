{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StyleCard",
  "description": "Defines visual style, aesthetic, and artistic direction.",
  "type": "object",
  "required": [
    "card_id",
    "card_type",
    "project_id",
    "owner_role",
    "status",
    "version",
    "required_inputs",
    "references",
    "constraints",
    "allowed_variations",
    "forbidden_drift",
    "dependencies",
    "approval_required_by",
    "next_action_if_missing",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "card_id": {
      "type": "string",
      "description": "Unique identifier for this card"
    },
    "card_type": {
      "type": "string",
      "const": "StyleCard",
      "description": "Card type identifier"
    },
    "project_id": {
      "type": "string",
      "description": "Project identifier"
    },
    "owner_role": {
      "type": "string",
      "enum": ["Director / Orchestrator"],
      "description": "Role that owns this card"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "needs_references", "needs_role_work", "ready_for_review", "approved", "blocked", "deprecated"],
      "description": "Current status of the card"
    },
    "version": {
      "type": "string",
      "description": "Card version"
    },
    "required_inputs": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "visual_reference_paths": {"type": "array", "items": {"type": "string"}},
        "aesthetic_description": {"type": "string"}
      },
      "required": ["name", "visual_reference_paths", "aesthetic_description"]
    },
    "references": {
      "type": "array",
      "items": {"type": "string"},
      "description": "No references (artistic direction)"
    },
    "constraints": {
      "type": "object",
      "properties": {
        "min_references": {"type": "integer"}
      }
    },
    "allowed_variations": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Allowed variations within this card type"
    },
    "forbidden_drift": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Changes that are not allowed once approved"
    },
    "dependencies": {
      "type": "array",
      "items": {"type": "string"},
      "description": "No dependencies (artistic direction)"
    },
    "approval_required_by": {
      "type": "string",
      "enum": ["Director / Orchestrator"],
      "description": "Role required to approve this card"
    },
    "next_action_if_missing": {
      "type": "string",
      "description": "Action to take if this card is missing"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when card was created"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when card was last updated"
    },
    "name": {
      "type": "string",
      "description": "Style name"
    },
    "director": {
      "type": "string",
      "description": "Director name or ID"
    },
    "visual_reference_paths": {
      "type": "array",
      "items": {"type": "string"},
      "description": "List of reference images"
    },
    "aesthetic_description": {
      "type": "string",
      "description": "Style description"
    },
    "color_palette": {
      "type": "object",
      "description": "Primary and secondary colors"
    },
    "texture_quality": {
      "type": "string",
      "description": "Detail level"
    },
    "rendering_style": {
      "type": "string",
      "enum": ["Photorealistic", "Stylized", "Anime", "Watercolor", "Oil Painting", "Digital Art"],
      "description": "Rendering style"
    }
  }
}
