{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PropCard",
  "description": "Defines objects, items, and set dressings used in scenes.",
  "type": "object",
  "required": [
    "card_id",
    "card_type",
    "project_id",
    "owner_role",
    "status",
    "version",
    "required_inputs",
    "references",
    "constraints",
    "allowed_variations",
    "forbidden_drift",
    "dependencies",
    "approval_required_by",
    "next_action_if_missing",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "card_id": {
      "type": "string",
      "description": "Unique identifier for this card"
    },
    "card_type": {
      "type": "string",
      "const": "PropCard",
      "description": "Card type identifier"
    },
    "project_id": {
      "type": "string",
      "description": "Project identifier"
    },
    "owner_role": {
      "type": "string",
      "enum": ["Prop Master / Environment Director"],
      "description": "Role that owns this card"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "needs_references", "needs_role_work", "ready_for_review", "approved", "blocked", "deprecated"],
      "description": "Current status of the card"
    },
    "version": {
      "type": "string",
      "description": "Card version"
    },
    "required_inputs": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "visual_reference_paths": {"type": "array", "items": {"type": "string"}},
        "description": {"type": "string"}
      },
      "required": ["name", "visual_reference_paths", "description"]
    },
    "references": {
      "type": "array",
      "items": {"type": "string"},
      "description": "No references (asset-level card)"
    },
    "constraints": {
      "type": "object",
      "properties": {
        "max_dimensions": {"type": "object"}
      }
    },
    "allowed_variations": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Allowed variations within this card type"
    },
    "forbidden_drift": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Changes that are not allowed once approved"
    },
    "dependencies": {
      "type": "array",
      "items": {"type": "string"},
      "description": "No dependencies (asset-level card)"
    },
    "approval_required_by": {
      "type": "string",
      "enum": ["Prop Master / Environment Director"],
      "description": "Role required to approve this card"
    },
    "next_action_if_missing": {
      "type": "string",
      "description": "Action to take if this card is missing"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when card was created"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when card was last updated"
    },
    "name": {
      "type": "string",
      "description": "Prop name"
    },
    "prop_master": {
      "type": "string",
      "description": "Prop master name or ID"
    },
    "visual_reference_paths": {
      "type": "array",
      "items": {"type": "string"},
      "description": "List of reference images"
    },
    "description": {
      "type": "string",
      "description": "Prop description"
    },
    "material": {
      "type": "string",
      "description": "Construction material"
    },
    "size_dimensions": {
      "type": "object",
      "description": "Physical dimensions"
    },
    "interaction_notes": {
      "type": "string",
      "description": "How prop is used"
    }
  }
}
